from types import TracebackType
from typing import Generic, Self, TypeVar

_T = TypeVar('_T')

class _IOBase(Generic[_T]):
    @property
    def name(self) -> str: ...
    @property
    def mode(self) -> str: ...
    @property
    def closed(self) -> bool: ...
    def close(self) -> None: ...
    def flush(self) -> None: ...
    def read(self, size: int | None = -1, /) -> _T: ...
    def readable(self) -> bool: ...
    def readline(self) -> _T: ...
    def readlines(self) -> list[_T]: ...
    def seek(self, offset: int, whence: int = 0, /) -> int: ...
    def seekable(self) -> bool: ...
    def tell(self) -> int: ...
    def writable(self) -> bool: ...
    def write(self, data: _T, /) -> int: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc: BaseException | None,
        traceback: TracebackType | None,
        /,
    ) -> None: ...

class FileIO(_IOBase[bytes]): ...
class BufferedReader(_IOBase[bytes]): ...
class BufferedWriter(_IOBase[bytes]): ...
class BufferedRandom(_IOBase[bytes]): ...

class TextIOWrapper(_IOBase[str]):
    @property
    def encoding(self) -> str: ...

class UnsupportedOperation(OSError, ValueError): ...
